# Tinu's Kitchen Bistro - Environment Variables Template
# Copy this file to .env and fill in your keys:
# cp .env.example .env

# Paystack API Keys (from Paystack Dashboard -> Settings -> API Keys & Webhooks)
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here

# Supabase Credentials (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key_here

# Admin Dashboard Password (used to unlock /admin.html)
ADMIN_PASSWORD=your_admin_password_here
